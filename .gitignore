# 보안: API 키 절대 업로드 금지
.env

# 불필요: 가상환경 및 캐시
venv/
__pycache__/
*.pyc
.DS_Store
pro_apps/
output_file

# target_apps 전체는 무시
target_apps/**

# 예외 규칙이 적용되도록 디렉터리 경로를 열어줌
!target_apps/
!target_apps/**/
!target_apps/**/tests/

# tests 안은 전부 무시
target_apps/**/tests/**

# 단, harness만 포함
!target_apps/**/tests/_harness.py
