# 보안: API 키 절대 업로드 금지
.env

# 불필요: 가상환경 및 캐시
venv/
__pycache__/
*.pyc
.DS_Store
pro_apps/

# target_apps 전체는 무시
target_apps/**

# 하지만 tests 폴더는 경로를 열어줘야 예외가 적용됨
!target_apps/**/tests/
!target_apps/**/tests/**

# tests 안에서는 전부 무시
target_apps/**/tests/**

# 단, harness만 다시 포함
!target_apps/**/tests/_harness.py
